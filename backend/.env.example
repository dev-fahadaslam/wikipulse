# Copy to .env and fill in to enable the AI features. Without a key set,
# the app runs fully offline with heuristic/templated fallbacks. Set one of
# ANTHROPIC_API_KEY or GEMINI_API_KEY (Anthropic takes priority if both are
# set); override the auto-detected choice with LLM_PROVIDER=anthropic|gemini.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=gemini

# "live" connects to the real Wikimedia stream; "sample" replays
# sample_events.jsonl on a loop (no network required).
EVENT_SOURCE=live

# Only used when EVENT_SOURCE=sample. 1.0 replays at recorded speed, 0 as
# fast as possible.
REPLAY_SPEED=0.3

# Wikimedia's edge 403s requests with a generic/default User-Agent (e.g. a
# bare "python-httpx/x.y.z") -- it wants something identifiable, per their
# API etiquette policy. The default below works, but consider swapping in
# your own repo URL/contact if you fork this.
# WIKIMEDIA_USER_AGENT=WikiPulse/1.0 (https://github.com/you/your-fork; you@example.com)
